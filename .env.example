# GROQ_API_KEY: Required for Groq LLM API career roadmap generation.
# Obtain a free API key at: https://console.groq.com/keys
# Supported models: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_API_KEY="gsk_your_groq_api_key_here"

# APP_URL: Hosted URL of the application
APP_URL="http://localhost:3000"

# PORT: Server port (defaults to 3000)
PORT="3000"
